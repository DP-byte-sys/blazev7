{
  "name": "blaze",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:build": "npm --prefix apps/web run build",
    "web:lint": "npm --prefix apps/web run lint",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "shared:typecheck": "npm --prefix packages/shared run typecheck",
    "check": "npm run format:check && npm run security:scan && npm run shared:typecheck && npm run db:test && npm run web:lint && npm run web:test && npm run web:build && npm run mobile:typecheck && npm run mobile:test",
    "web:test": "npm --prefix apps/web run test",
    "mobile:test": "npm --prefix apps/mobile run test",
    "db:test": "vitest run",
    "security:scan": "node scripts/scan-secrets.mjs",
    "release:check": "node scripts/check-release-record.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "prettier": "^3.3.3",
    "vitest": "^5.0.5"
  }
}
