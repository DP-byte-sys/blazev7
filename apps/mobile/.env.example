# Copy to .env (never commit it). Only the PUBLISHABLE (anon) key belongs here.
# NEVER put a Supabase service-role key in this app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The app variant (name, package, banner) comes from APP_ENV, set per build profile in eas.json; see docs/mobile-distribution.md.
