# Copy to .env.local (never commit it). Only the PUBLISHABLE (anon) key belongs here.
# NEVER put a Supabase service-role key in this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# development | uat | staging | production. Anything else (or unset) shows the development banner.
VITE_APP_ENV=development
